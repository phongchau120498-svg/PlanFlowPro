#!/usr/bin/expect -f
set timeout 15
spawn ssh -p 2018 -o StrictHostKeyChecking=no root@103.97.126.131

expect {
    "*assword:*" {
        send "5w4lAW78nd\r"
    }
    timeout { exit 1 }
}

expect "*# "
# Xem agent id của ram-ram
send "docker exec goclaw-postgres-1 psql -U goclaw -d goclaw -c \"SELECT id, agent_key FROM agents WHERE agent_key = 'ram-ram';\"\r"
expect "*# "

# Xóa episodic summaries của bot (long-term memory về tool)
send "docker exec goclaw-postgres-1 psql -U goclaw -d goclaw -c \"DELETE FROM episodic_summaries WHERE summary ILIKE '%add_brain_knowledge%';\"\r"
expect "*# "

# Xóa memory chunks có liên quan
send "docker exec goclaw-postgres-1 psql -U goclaw -d goclaw -c \"DELETE FROM memory_chunks WHERE text ILIKE '%add_brain_knowledge%';\"\r"
expect "*# "

send "docker exec goclaw-postgres-1 psql -U goclaw -d goclaw -c \"SELECT COUNT(*) FROM episodic_summaries;\"\r"
expect "*# "

send "exit\r"
expect eof
