#!/usr/bin/expect -f
set timeout 15
spawn ssh -p 2018 -o StrictHostKeyChecking=no root@103.97.126.131

expect {
    "*assword:*" {
        send "5w4lAW78nd\r"
    }
    timeout { exit 1 }
}

expect "*# "
send "docker exec goclaw-postgres-1 psql -U goclaw -d goclaw -c \"SELECT content FROM agent_context_files WHERE file_name IN ('AGENTS_TASK.md', 'AGENTS_CORE.md');\" | grep -i 'add_brain_knowledge\\|knowledge\\|tool'\r"
expect "*# "

send "docker exec goclaw-postgres-1 psql -U goclaw -d goclaw -c \"SELECT file_name, content FROM agent_context_files WHERE content ILIKE '%add_brain%';\"\r"
expect "*# "

send "exit\r"
expect eof
