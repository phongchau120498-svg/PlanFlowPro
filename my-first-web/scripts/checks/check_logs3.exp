#!/usr/bin/expect -f
set timeout 15
spawn ssh -p 2018 -o StrictHostKeyChecking=no root@103.97.126.131

expect {
    "*assword:*" {
        send "5w4lAW78nd\r"
    }
    timeout {
        puts "Timeout waiting for password prompt"
        exit 1
    }
}

expect "*# "
send "journalctl -u mcp-server.service -n 200 --no-pager | grep -i 'update_active_promotion'\r"
expect "*# "

send "exit\r"
expect eof
