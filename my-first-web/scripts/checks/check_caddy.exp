#!/usr/bin/expect -f
set timeout 15
spawn ssh -p 2018 -o StrictHostKeyChecking=no root@103.97.126.131

expect {
    "*assword:*" {
        send "5w4lAW78nd\r"
    }
    timeout { exit 1 }
}

expect "*# "
send "cat /opt/my-website/Caddyfile 2>/dev/null || cat /etc/caddy/Caddyfile 2>/dev/null | head -60\r"
expect "*# "

send "curl -s https://moawmoaws.beauty/standalone-mcp/mcp -X POST -H 'Content-Type: application/json' -d '{\"jsonrpc\":\"2.0\",\"method\":\"tools/list\",\"id\":1}' | grep -o 'add_brain_knowledge'\r"
expect "*# "

send "exit\r"
expect eof
