#!/usr/bin/expect -f
set timeout 15
spawn ssh -p 2018 -o StrictHostKeyChecking=no root@103.97.126.131

expect {
    "*assword:*" {
        send "5w4lAW78nd\r"
    }
    timeout { exit 1 }
}

expect "*# "
send "docker exec goclaw-postgres-1 psql -U goclaw -d goclaw -c \"SELECT column_name FROM information_schema.columns WHERE table_name='agent_context_files';\"\r"
expect "*# "

send "docker exec goclaw-postgres-1 psql -U goclaw -d goclaw -c \"SELECT id, file_name, length(content) FROM agent_context_files LIMIT 20;\"\r"
expect "*# "

send "exit\r"
expect eof
