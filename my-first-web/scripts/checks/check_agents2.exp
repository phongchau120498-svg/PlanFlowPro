#!/usr/bin/expect -f
set timeout 15
spawn ssh -p 2018 -o StrictHostKeyChecking=no root@103.97.126.131

expect {
    "*assword:*" {
        send "5w4lAW78nd\r"
    }
    timeout {
        puts "Timeout waiting for password prompt"
        exit 1
    }
}

expect "*# "
send "docker exec goclaw-postgres-1 psql -U goclaw -d goclaw -c \"SELECT id, display_name, provider, model FROM agents;\"\r"
expect "*# "

send "exit\r"
expect eof
