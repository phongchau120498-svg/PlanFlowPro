#!/usr/bin/expect -f
set timeout 15
spawn ssh -p 2018 -o StrictHostKeyChecking=no root@103.97.126.131

expect {
    "*assword:*" {
        send "5w4lAW78nd\r"
    }
    timeout {
        puts "Timeout waiting for password prompt"
        exit 1
    }
}

expect "*# "
send "export \$(cat /opt/my-website/.env | grep -v '^#')\r"
expect "*# "

send "curl -s -H \"apikey: \${SUPABASE_ANON_KEY}\" -H \"Authorization: Bearer \${SUPABASE_ANON_KEY}\" \"\${SUPABASE_URL}/rest/v1/popups?select=*\"\r"
expect "*# "

send "exit\r"
expect eof
